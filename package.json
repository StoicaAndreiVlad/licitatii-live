{
  "name": "licitatii-live",
  "version": "0.1.0",
  "private": true,
  "description": "Licitații fictive în timp real — proiect Tehnologii Web (mafia team)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server",
    "test": "npm test -w server",
    "coverage": "npm run coverage -w server",
    "build": "npm run build -w client",
    "start": "npm start -w server"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "esbuild@0.28.2": true
  }
}
