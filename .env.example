# Copiați acest fișier în .env (în rădăcina proiectului) și completați valorile.
# Nu puneți niciodată chei reale în .env.example și nu adăugați .env în Git.

NODE_ENV=development
PORT=3000

# Calea este relativă la folderul server/
DATABASE_FILE=./data/licitatii.sqlite

# Șir aleator de minimum 32 de caractere (obligatoriu în producție)
JWT_SECRET=inlocuiti-cu-un-sir-aleator-de-minimum-32-caractere

# Originea SPA-ului în dezvoltare (Vite)
CLIENT_ORIGIN=http://localhost:5173

# Furnizorul de curs valutar: simulator (implicit, cost zero) sau frankfurter
RATES_PROVIDER=simulator
RATES_BASE_URL=https://api.frankfurter.app

# Parolele conturilor sintetice create de seed (doar pentru dezvoltare locală)
SEED_ADMIN_PASSWORD=Organizator#2026
SEED_BIDDER_PASSWORD=Licitator#2026
